# Copy to .env.local and fill in. Never commit .env.local.

# Public address of the site, no trailing slash. Used for canonical URLs,
# the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs login sessions. At least 32 random characters:
#   openssl rand -base64 48
SESSION_SECRET=

# Database. Leave unset in development to use a local file (data/easyserve.db).
# In production use a hosted libSQL / Turso database.
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=

# Admin account, created with: npm run create-admin
ADMIN_NAME=EasyServe Admin
ADMIN_PHONE=
ADMIN_PASSWORD=

# Optional. Google Analytics 4 ID. Loads only after a visitor accepts cookies.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
